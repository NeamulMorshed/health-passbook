rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isDoctor() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'doctor';
    }

    function isPatient() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'patient';
    }

    function doctorHasPatient(patientId) {
      return patientId in get(/databases/$(database)/documents/doctors/$(request.auth.uid)).data.patientIds;
    }

    // ── users ────────────────────────────────────────────────────────────────
    // Each user can only read and write their own document.

    match /users/{uid} {
      allow read:  if isSignedIn() && isOwner(uid);
      allow write: if isSignedIn() && isOwner(uid);
    }

    // ── patients ─────────────────────────────────────────────────────────────
    // Patients own their profile and all subcollections.
    // Doctors can read a patient's profile if the patient is in their patientIds list.

    match /patients/{patientId} {
      allow read:  if isSignedIn() && (isOwner(patientId) || (isDoctor() && doctorHasPatient(patientId)));
      allow write: if isSignedIn() && isOwner(patientId);

      match /medicines/{medId} {
        allow read:           if isSignedIn() && (isOwner(patientId) || (isDoctor() && doctorHasPatient(patientId)));
        allow create:         if isSignedIn() && (isOwner(patientId) || isDoctor());
        allow update, delete: if isSignedIn() && isOwner(patientId);
      }

      match /meals/{mealId} {
        allow read, write: if isSignedIn() && isOwner(patientId);
      }

      match /activity_logs/{logId} {
        allow read, write: if isSignedIn() && isOwner(patientId);
      }

      match /notifications/{notifId} {
        allow read, write: if isSignedIn() && isOwner(patientId);
      }
    }

    // ── doctors ──────────────────────────────────────────────────────────────
    // Doctors own their profile.
    // Patients can read doctor profiles (for search and booking).
    // The patientIds array can also be updated when a patient books an appointment.

    match /doctors/{doctorId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner(doctorId);
      allow update: if isSignedIn() && isPatient() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['patientIds']);
    }

    // ── appointments ─────────────────────────────────────────────────────────
    // Both parties can read their own appointments.
    // Patients create appointments.
    // Doctors update status, scheduledAt, and notes only.

    match /appointments/{apptId} {
      allow read: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId  == request.auth.uid
      );

      allow create: if isSignedIn() && isPatient() &&
        request.resource.data.patientId == request.auth.uid;

      allow update: if isSignedIn() && resource.data.doctorId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'scheduledAt', 'notes', 'updatedAt']);
    }

    // ── prescriptions ─────────────────────────────────────────────────────────
    // Both parties can read. Only the issuing doctor can write.

    match /prescriptions/{rxId} {
      allow read: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId  == request.auth.uid
      );

      allow create: if isSignedIn() && isDoctor() &&
        request.resource.data.doctorId == request.auth.uid;
    }
  }
}
