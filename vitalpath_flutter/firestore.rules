rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isDoctor() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'doctor';
    }

    function isPatient() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'patient';
    }

    function doctorHasPatient(patientId) {
      return exists(/databases/$(database)/documents/doctors/$(request.auth.uid)/connections/$(patientId));
    }

    // Written by InviteResponseNotifier.accept() so rules can check caregiver
    // access without a collection query (Firestore rules don't support queries).
    function isCaregiverFor(patientId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/patients/$(patientId)/caregivers/$(request.auth.uid));
    }

    // Checks that the connected caregiver has permission for a specific section.
    // Mirror doc carries a 'permissions' map written on accept + on each save.
    // Defensive default: missing 'permissions' field or missing section key → true
    // (preserves access for existing connections that pre-date this field).
    function caregiverCanRead(patientId, section) {
      return isCaregiverFor(patientId) &&
        get(/databases/$(database)/documents/patients/$(patientId)/caregivers/$(request.auth.uid))
          .data.get('permissions', {}).get(section, true) == true;
    }

    // ── users ────────────────────────────────────────────────────────────────

    match /users/{uid} {
      allow read:   if isSignedIn() && isOwner(uid);
      allow create: if isSignedIn() && isOwner(uid);
      // S-02: block userType self-escalation — owner cannot change their own role after creation.
      allow update: if isSignedIn() && isOwner(uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userType']);
      allow delete: if isSignedIn() && isOwner(uid);
    }

    // ── patients ─────────────────────────────────────────────────────────────

    match /patients/{patientId} {
      allow read:  if isSignedIn() && (isOwner(patientId) || (isDoctor() && doctorHasPatient(patientId)));
      allow write: if isSignedIn() && isOwner(patientId);

      match /medicines/{medId} {
        allow read:           if isSignedIn() && (isOwner(patientId) || (isDoctor() && doctorHasPatient(patientId)) || caregiverCanRead(patientId, 'medicines'));
        // S-03: doctor must have an active connection to this patient before writing medicines.
        allow create:         if isSignedIn() && (isOwner(patientId) || (isDoctor() && doctorHasPatient(patientId)));
        allow update, delete: if isSignedIn() && isOwner(patientId);
      }

      match /meals/{mealId} {
        allow read:  if isSignedIn() && (isOwner(patientId) || caregiverCanRead(patientId, 'mealLogs'));
        allow write: if isSignedIn() && isOwner(patientId);
      }

      match /activity_logs/{logId} {
        allow read:  if isSignedIn() && (isOwner(patientId) || caregiverCanRead(patientId, 'activityLogs'));
        allow write: if isSignedIn() && isOwner(patientId);
      }

      // Notifications: patient owns them, but any authenticated user (doctor) can create.
      match /notifications/{notifId} {
        allow read:   if isSignedIn() && isOwner(patientId);
        allow create: if isSignedIn();
        allow update: if isSignedIn() && isOwner(patientId);
        allow delete: if isSignedIn() && isOwner(patientId);
      }

      match /family_members/{memberId} {
        allow read:           if isSignedIn() && (isOwner(patientId) || (isDoctor() && doctorHasPatient(patientId)));
        allow create, update: if isSignedIn() && isOwner(patientId);
        allow delete:         if isSignedIn() && isOwner(patientId);

        match /medicines/{medId} {
          allow read, write: if isSignedIn() && isOwner(patientId);
        }
      }

      // Mirror document written by caregiver on accept so isCaregiverFor() works.
      match /caregivers/{caregiverUid} {
        allow read:           if isSignedIn() && (isOwner(patientId) || isOwner(caregiverUid));
        allow create, update: if isSignedIn() && isOwner(caregiverUid);
        allow delete:         if isSignedIn() && (isOwner(patientId) || isOwner(caregiverUid));
      }

      // Patient ↔ Doctor connections — doctor creates both sides during confirmation batch.
      match /connections/{doctorId} {
        allow read:   if isSignedIn() && (isOwner(patientId) || isOwner(doctorId));
        allow create: if isSignedIn() && (isOwner(patientId) || isOwner(doctorId));
        allow delete: if isSignedIn() && (isOwner(patientId) || isOwner(doctorId));
      }
    }

    // ── doctors ──────────────────────────────────────────────────────────────

    match /doctors/{doctorId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn() && isOwner(doctorId);

      // Doctor ↔ Patient connections — doctor creates both sides during confirmation batch.
      match /connections/{patientId} {
        allow read:   if isSignedIn() && (isOwner(doctorId) || isOwner(patientId));
        allow create: if isSignedIn() && (isOwner(doctorId) || isOwner(patientId));
        allow delete: if isSignedIn() && (isOwner(doctorId) || isOwner(patientId));
      }
    }

    // ── appointments ─────────────────────────────────────────────────────────

    match /appointments/{apptId} {
      allow get: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId  == request.auth.uid ||
        caregiverCanRead(resource.data.patientId, 'appointments')
      );
      // S-01: scope list queries — client must filter by patientId or doctorId equal to their own uid.
      // Side-bug fix: appointments list rule was missing caregiver arm (prescriptions/vitals had it).
      allow list: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId  == request.auth.uid ||
        caregiverCanRead(resource.data.patientId, 'appointments')
      );

      allow create: if isSignedIn() && isPatient() &&
        request.resource.data.patientId == request.auth.uid;

      allow update: if isSignedIn() && (
        // Doctor can confirm, complete, cancel — may change status/scheduledAt/notes/updatedAt.
        (resource.data.doctorId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'scheduledAt', 'notes', 'updatedAt'])) ||
        // Patient can cancel only their own pending appointments.
        (resource.data.patientId == request.auth.uid &&
         resource.data.status == 'pending' &&
         request.resource.data.status == 'cancelled' &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'updatedAt'])) ||
        // 7a: Either party may update message metadata (last message preview + ts)
        // when a new chat message is sent. Limited to the message-related fields
        // so nothing else can change.
        ((resource.data.patientId == request.auth.uid ||
          resource.data.doctorId == request.auth.uid) &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['lastMessageAt', 'lastMessagePreview']))
      );

      // 7a: Messages subcollection — appointment-scoped chat.
      // participants array (denormalized [patientId, doctorId]) makes the
      // rule cheap (no get() lookup per message). senderId must equal auth.uid.
      // Updates restricted to readAt-only so messages stay immutable.
      match /messages/{msgId} {
        allow read: if isSignedIn() &&
          request.auth.uid in resource.data.participants;
        allow list: if isSignedIn();
        allow create: if isSignedIn() &&
          request.auth.uid in request.resource.data.participants &&
          request.auth.uid == request.resource.data.senderId;
        allow update: if isSignedIn() &&
          request.auth.uid in resource.data.participants &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['readAt']);
      }
    }

    // ── prescriptions ─────────────────────────────────────────────────────────

    match /prescriptions/{rxId} {
      allow get: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId  == request.auth.uid ||
        (isDoctor() && doctorHasPatient(resource.data.patientId)) ||
        caregiverCanRead(resource.data.patientId, 'prescriptions')
      );
      // S-01: scope list queries — patient, doctor (own), or connected caregiver with permission.
      allow list: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId  == request.auth.uid ||
        caregiverCanRead(resource.data.patientId, 'prescriptions')
      );

      // S-04: doctor must have an active connection to this patient before prescribing.
      allow create: if isSignedIn() && isDoctor() &&
        request.resource.data.doctorId == request.auth.uid &&
        doctorHasPatient(request.resource.data.patientId);
    }

    // ── vitals ────────────────────────────────────────────────────────────────

    match /vitals/{readingId} {
      allow get: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        (isDoctor() && doctorHasPatient(resource.data.patientId)) ||
        caregiverCanRead(resource.data.patientId, 'vitals')
      );
      // S-01: scope list queries — patient, connected doctor, or connected caregiver with permission.
      allow list: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        (isDoctor() && doctorHasPatient(resource.data.patientId)) ||
        caregiverCanRead(resource.data.patientId, 'vitals')
      );
      allow create: if isSignedIn() &&
        request.resource.data.patientId == request.auth.uid;
      allow delete: if isSignedIn() &&
        resource.data.patientId == request.auth.uid;
    }

    // ── caregiver_connections ─────────────────────────────────────────────────
    // Patient creates and owns connections. Caregiver (matched by email or UID)
    // can read their own and update to accept/decline an invite.

    match /caregiver_connections/{connId} {
      // 7b: doctor may read patient's family members iff the patient opted-in
      // via users/{patientId}.shareCircleWithDoctors == true. The get() in
      // rules costs 1 billable read per evaluation; bounded because doctor
      // patient view filters by patientId (~3–5 docs per query).
      allow get: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.caregiverUid == request.auth.uid ||
        // S-05: lower() on both sides so "User@Example.com" stored == "user@example.com" token.
        resource.data.caregiverEmail.lower() == request.auth.token.email.lower() ||
        (isDoctor() && doctorHasPatient(resource.data.patientId) &&
          get(/databases/$(database)/documents/users/$(resource.data.patientId)).data.shareCircleWithDoctors == true)
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.patientId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.caregiverEmail.lower() == request.auth.token.email.lower() ||
        resource.data.caregiverUid == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.caregiverUid == request.auth.uid
      );
    }

    // ── S-09: Collection-group guard for medicines ────────────────────────────
    // The COLLECTION_GROUP index on medicines exists for Cloud Functions only
    // (admin SDK bypasses these rules). This wildcard rule makes the access
    // boundary explicit: client-side collection-group queries must include a
    // patientId filter equal to the requester's own UID (or a doctor/caregiver
    // with an active connection). Unconstrained cross-patient scans are rejected
    // by Firestore at query evaluation time because the rule cannot be satisfied
    // for documents belonging to other patients.
    match /{path=**}/medicines/{medId} {
      allow read: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        (isDoctor() && doctorHasPatient(resource.data.patientId)) ||
        caregiverCanRead(resource.data.patientId, 'medicines')
      );
    }

    // ── gamification ──────────────────────────────────────────────────────────

    match /gamification/{uid} {
      allow read, write: if isSignedIn() && isOwner(uid);
    }

    // ── Shared drug-lookup caches (Phase B + C) ───────────────────────────────
    // Populated by any authenticated user, readable by all authenticated users.
    // This is intentional: shared caches mean each unique drug name / pair is
    // looked up only once across the entire user base.

    match /rxnorm_cache/{doc} {
      allow read, write: if isSignedIn();
    }

    match /drug_interaction_cache/{doc} {
      allow read, write: if isSignedIn();
    }

    // ── invites ───────────────────────────────────────────────────────────────
    // External-share telemetry: when a patient uses "Invite Family Member" to
    // share the app with someone outside it, we record the intent here.
    // Write-only from the inviter; readable only by the inviter for their own
    // history (no third party ever queries this collection).
    match /invites/{inviteId} {
      allow create: if isSignedIn() &&
        request.resource.data.fromUid == request.auth.uid;
      allow read: if isSignedIn() &&
        resource.data.fromUid == request.auth.uid;
    }
  }
}
