rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isDoctor() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'doctor';
    }

    function isPatient() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'patient';
    }

    function doctorHasPatient(patientId) {
      return exists(/databases/$(database)/documents/doctors/$(request.auth.uid)/connections/$(patientId));
    }

    // Written by InviteResponseNotifier.accept() so rules can check caregiver
    // access without a collection query (Firestore rules don't support queries).
    function isCaregiverFor(patientId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/patients/$(patientId)/caregivers/$(request.auth.uid));
    }

    // ── users ────────────────────────────────────────────────────────────────

    match /users/{uid} {
      allow read:  if isSignedIn() && isOwner(uid);
      allow write: if isSignedIn() && isOwner(uid);
    }

    // ── patients ─────────────────────────────────────────────────────────────

    match /patients/{patientId} {
      allow read:  if isSignedIn() && (isOwner(patientId) || (isDoctor() && doctorHasPatient(patientId)));
      allow write: if isSignedIn() && isOwner(patientId);

      match /medicines/{medId} {
        allow read:           if isSignedIn() && (isOwner(patientId) || (isDoctor() && doctorHasPatient(patientId)) || isCaregiverFor(patientId));
        allow create:         if isSignedIn() && (isOwner(patientId) || isDoctor());
        allow update, delete: if isSignedIn() && isOwner(patientId);
      }

      match /meals/{mealId} {
        allow read:  if isSignedIn() && (isOwner(patientId) || isCaregiverFor(patientId));
        allow write: if isSignedIn() && isOwner(patientId);
      }

      match /activity_logs/{logId} {
        allow read:  if isSignedIn() && (isOwner(patientId) || isCaregiverFor(patientId));
        allow write: if isSignedIn() && isOwner(patientId);
      }

      // Notifications: patient owns them, but any authenticated user (doctor) can create.
      match /notifications/{notifId} {
        allow read:   if isSignedIn() && isOwner(patientId);
        allow create: if isSignedIn();
        allow update: if isSignedIn() && isOwner(patientId);
        allow delete: if isSignedIn() && isOwner(patientId);
      }

      match /family_members/{memberId} {
        allow read:           if isSignedIn() && (isOwner(patientId) || (isDoctor() && doctorHasPatient(patientId)));
        allow create, update: if isSignedIn() && isOwner(patientId);
        allow delete:         if isSignedIn() && isOwner(patientId);

        match /medicines/{medId} {
          allow read, write: if isSignedIn() && isOwner(patientId);
        }
      }

      // Mirror document written by caregiver on accept so isCaregiverFor() works.
      match /caregivers/{caregiverUid} {
        allow read:           if isSignedIn() && (isOwner(patientId) || isOwner(caregiverUid));
        allow create, update: if isSignedIn() && isOwner(caregiverUid);
        allow delete:         if isSignedIn() && (isOwner(patientId) || isOwner(caregiverUid));
      }

      // Patient ↔ Doctor connections — doctor creates both sides during confirmation batch.
      match /connections/{doctorId} {
        allow read:   if isSignedIn() && (isOwner(patientId) || isOwner(doctorId));
        allow create: if isSignedIn() && (isOwner(patientId) || isOwner(doctorId));
        allow delete: if isSignedIn() && (isOwner(patientId) || isOwner(doctorId));
      }
    }

    // ── doctors ──────────────────────────────────────────────────────────────

    match /doctors/{doctorId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn() && isOwner(doctorId);

      // Doctor ↔ Patient connections — doctor creates both sides during confirmation batch.
      match /connections/{patientId} {
        allow read:   if isSignedIn() && (isOwner(doctorId) || isOwner(patientId));
        allow create: if isSignedIn() && (isOwner(doctorId) || isOwner(patientId));
        allow delete: if isSignedIn() && (isOwner(doctorId) || isOwner(patientId));
      }
    }

    // ── appointments ─────────────────────────────────────────────────────────

    match /appointments/{apptId} {
      // Single-document reads: resource.data is available.
      allow get: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId  == request.auth.uid ||
        isCaregiverFor(resource.data.patientId)
      );
      // Collection queries: resource.data is NOT available at query evaluation
      // time. Allow any authenticated user — the SDK query always includes a
      // patientId/doctorId == auth.uid filter so only their own docs are returned.
      allow list: if isSignedIn();

      allow create: if isSignedIn() && isPatient() &&
        request.resource.data.patientId == request.auth.uid;

      allow update: if isSignedIn() && (
        // Doctor can confirm, complete, cancel — may change status/scheduledAt/notes/updatedAt.
        (resource.data.doctorId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'scheduledAt', 'notes', 'updatedAt'])) ||
        // Patient can cancel only their own pending appointments.
        (resource.data.patientId == request.auth.uid &&
         resource.data.status == 'pending' &&
         request.resource.data.status == 'cancelled' &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'updatedAt']))
      );
    }

    // ── prescriptions ─────────────────────────────────────────────────────────

    match /prescriptions/{rxId} {
      allow get: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId  == request.auth.uid ||
        (isDoctor() && doctorHasPatient(resource.data.patientId)) ||
        isCaregiverFor(resource.data.patientId)
      );
      allow list: if isSignedIn();

      allow create: if isSignedIn() && isDoctor() &&
        request.resource.data.doctorId == request.auth.uid;
    }

    // ── vitals ────────────────────────────────────────────────────────────────

    match /vitals/{readingId} {
      allow get: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        (isDoctor() && doctorHasPatient(resource.data.patientId)) ||
        isCaregiverFor(resource.data.patientId)
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.patientId == request.auth.uid;
      allow delete: if isSignedIn() &&
        resource.data.patientId == request.auth.uid;
    }

    // ── caregiver_connections ─────────────────────────────────────────────────
    // Patient creates and owns connections. Caregiver (matched by email or UID)
    // can read their own and update to accept/decline an invite.

    match /caregiver_connections/{connId} {
      allow get: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.caregiverUid == request.auth.uid ||
        resource.data.caregiverEmail == request.auth.token.email ||
        resource.data.caregiverEmail == request.auth.token.email.lower()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.patientId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.caregiverEmail == request.auth.token.email ||
        resource.data.caregiverEmail == request.auth.token.email.lower() ||
        resource.data.caregiverUid == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.caregiverUid == request.auth.uid
      );
    }

    // ── gamification ──────────────────────────────────────────────────────────

    match /gamification/{uid} {
      allow read, write: if isSignedIn() && isOwner(uid);
    }

    // ── Shared drug-lookup caches (Phase B + C) ───────────────────────────────
    // Populated by any authenticated user, readable by all authenticated users.
    // This is intentional: shared caches mean each unique drug name / pair is
    // looked up only once across the entire user base.

    match /rxnorm_cache/{doc} {
      allow read, write: if isSignedIn();
    }

    match /drug_interaction_cache/{doc} {
      allow read, write: if isSignedIn();
    }
  }
}
